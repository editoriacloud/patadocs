# Watermarked previews only. Nothing here may ever be executed.
Options -Indexes
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
