# ==========================================================================
# PATADOCS — Apache configuration (cPanel / XAMPP / shared hosting)
# Requires mod_rewrite for clean URLs. Without it, set Admin → Settings →
# "Clean URLs" to OFF and the site uses document.php?slug=... style links.
# ==========================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- HTTPS + www/non-www: PHP already 301-redirects every page to BASE_URL's scheme and host
#     (Admin → Settings → SEO → "Redirect to the canonical domain"). Uncomment to do it for static files too.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Never expose these folders / files ---
RewriteRule ^(private_documents|includes)(/|$) - [F,L]
RewriteRule ^uploads/temporary(/|$) - [F,L]
RewriteRule \.(sql|md|log|ini|bak|sh|inc)$ - [F,L]

# --- SEO endpoints (before the real-file rule so they always win) ---
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^ads\.txt$ adstxt.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap-([a-z]+)(?:-([0-9]+))?\.xml$ sitemap.php?part=$1&n=$2 [L,QSA]
RewriteRule ^([a-f0-9]{32})\.txt$ indexnow.php?key=$1 [L]

# --- Real files and folders are served as they are ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Blog: /blog/, /blog/<post>, /blog/category/<slug>, /blog/tag/<slug>, /blog/author/<user>, /blog/feed ---
RewriteRule ^blog(?:/(.*))?$ blog.php?route=$1 [L,QSA]

# --- Top level pages: /search /about /contribute ... ---
RewriteRule ^(search|categories|popular|contribute|request-document|about|contact|recover|saved|payment|payment-success|download|privacy-policy|terms|cookie-policy|copyright|disclaimer)/?$ $1.php [L,QSA]

# --- Everything else → router (categories, documents, collections) ---
RewriteRule ^(.+)$ router.php?path=$1 [L,QSA]
</IfModule>

# --- Sensitive files can never be downloaded ---
<FilesMatch "\.(sql|md|log|ini|bak|sh|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Performance: compression + browser caching (assets are versioned with ?v=) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
